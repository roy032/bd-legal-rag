# Answering model — pick one. Leave RAG_LLM=echo for retrieval-only operation.
RAG_LLM=ollama               # ollama | compat | groq | gemini | hf | anthropic | openai | echo
RAG_MODEL=gemma4:e4b         # e.g. gemma4:e4b, llama-3.3-70b-versatile, gemini-flash-latest
RAG_LLM_BASE_URL=            # compat: any OpenAI-compatible server, e.g. http://127.0.0.1:8080/v1
RAG_LLM_API_KEY=             # compat: only if that server wants one
GROQ_API_KEY=                # free key: console.groq.com
GEMINI_API_KEY=              # free key: aistudio.google.com
HF_TOKEN=                    # free token: huggingface.co/settings/tokens
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192          # Ollama's default window is too small for 5 Bangla excerpts
OLLAMA_KEEP_ALIVE=30m        # keep the model loaded between questions (reloading costs 10-30 s)
RAG_EXCERPT_CHARS=1500       # characters of each excerpt the model reads; 1000 is faster on a CPU
RAG_MAX_TOKENS=1024
RAG_LLM_TIMEOUT=120

# Service
BDRAG_INDEX=data/index
BDRAG_CHUNKS=data/processed/chunks.jsonl
BDRAG_EMBEDDER=auto          # auto = whatever the index was built with
BDRAG_MODE=dense             # dense | bm25 | hybrid (dense won on the tuning split)
BDRAG_RERANK=none            # none | cross | lexical
BDRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BDRAG_RERANK_TOP=20          # cross-encoder only re-scores the top N (GPU: 50, CPU: 10-20)
BDRAG_RERANK_PRECISION=auto  # auto (bf16 where the CPU has it, else fp32) | int8 (~2x faster) | fp32
BDRAG_REWRITE=colloquial     # none | colloquial | always (two extra model calls when it fires)
BDRAG_TRANSLATE=true         # also search the question in the other language (one short model call)
BDRAG_RESOLVE_REFS=true      # "দণ্ডবিধির ধারা ৩০২" -> direct lookup
BDRAG_TOPICS=true            # unpaid salary / defamation / faulty goods ... -> governing sections pinned
BDRAG_TOPIC_SLOTS=3          # places in the top k those sections may take
BDRAG_GENERAL_FALLBACK=true  # no matching provision -> labelled general guidance + legal-aid note
BDRAG_K=5
BDRAG_MIN_SCORE=             # from scripts/calibrate_guard.py — leave empty to disable abstention
BDRAG_AGENT=true
BDRAG_RATE_PER_MIN=20
BDRAG_BURST=5                # requests a client may make at once before the per-minute rate applies
BDRAG_DAILY_LIMIT=0          # answers per day across all visitors (0 = no cap); set it on a public demo
BDRAG_MAX_INFLIGHT=2         # answers the model works on at once (0 = no limit)
BDRAG_MAX_QUEUE=8            # more may wait; past that a visitor gets the matching sections at once
BDRAG_BREAKER_FAILURES=3     # model failures in a row that pause it (0 = never)
BDRAG_BREAKER_COOLDOWN=30    # seconds it stays paused before one trial answer
BDRAG_MAX_BODY=16384         # bytes; larger requests get 413
BDRAG_METRICS_TOKEN=         # set to require "Authorization: Bearer <token>" on /metrics
LOG_FORMAT=text              # json = one JSON object per line, with the request id
BDRAG_MODELS=                # model picker, default first: ollama:gemma4:e4b,groq:llama-3.3-70b-versatile
BDRAG_TRUST_PROXY=false      # true only behind your own reverse proxy (X-Forwarded-For)
BDRAG_CORS=*
BDRAG_ANSWERS_DB=data/answers.sqlite3  # shared answers (/a/<id>) survive restarts; empty = memory only
BDRAG_ANSWER_DAYS=90         # shared answers are deleted after this many days (0 = never)
BDRAG_LOG_DAYS=90            # query and feedback log rows are deleted after this many days (0 = never)
BDRAG_HOUSEKEEPING_S=21600   # how often retention runs, in seconds (also once at startup)
BDRAG_INDEX_MAX_AGE_DAYS=45  # `bdrag doctor` warns when the index is older than this
