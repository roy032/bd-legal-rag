# Answering model — pick one. Leave RAG_LLM=echo for retrieval-only operation.
RAG_LLM=ollama               # ollama | compat | groq | gemini | hf | anthropic | openai | echo
RAG_MODEL=qwen2.5:7b         # e.g. qwen2.5:7b, llama-3.3-70b-versatile, gemini-flash-latest
RAG_LLM_BASE_URL=            # compat: any OpenAI-compatible server, e.g. http://127.0.0.1:8080/v1
RAG_LLM_API_KEY=             # compat: only if that server wants one
GROQ_API_KEY=                # free key: console.groq.com
GEMINI_API_KEY=              # free key: aistudio.google.com
HF_TOKEN=                    # free token: huggingface.co/settings/tokens
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192          # Ollama's default window is too small for 5 Bangla excerpts
RAG_MAX_TOKENS=1024
RAG_LLM_TIMEOUT=120

# Service
BDRAG_INDEX=data/index
BDRAG_CHUNKS=data/processed/chunks.jsonl
BDRAG_EMBEDDER=auto          # auto = whatever the index was built with
BDRAG_MODE=dense             # dense | bm25 | hybrid (dense won on the tuning split)
BDRAG_RERANK=none            # none | cross | lexical
BDRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BDRAG_RERANK_TOP=20          # cross-encoder only re-scores the top N (GPU: 50, CPU: 10-20)
BDRAG_REWRITE=colloquial     # none | colloquial | always (two extra model calls when it fires)
BDRAG_RESOLVE_REFS=true      # "দণ্ডবিধির ধারা ৩০২" -> direct lookup
BDRAG_K=5
BDRAG_MIN_SCORE=             # from scripts/calibrate_guard.py — leave empty to disable abstention
BDRAG_AGENT=true
BDRAG_RATE_PER_MIN=20
BDRAG_TRUST_PROXY=false      # true only behind your own reverse proxy (X-Forwarded-For)
BDRAG_CORS=*
